<Window x:Class="FundMarket.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Stock Market Dashboard"
        Height="600" Width="900"
        Icon="/Assets/icon.ico"
        mc:Ignorable="d"
        Background="{StaticResource Brush.Background}">
    
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Tickers">
                <Grid Margin="16" DataContext="{Binding TickersViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!--  Top bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                        <TextBox Width="200" 
                                 Margin="0,0,8,0"
                                 Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Add Ticker"
                                Command="{Binding AddTickerCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Save Selected"
                                Command="{Binding SaveTickerCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Save All"
                                Command="{Binding SaveAllTickersCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Delete Selected"
                                Background="{StaticResource Brush.Error}"
                                Command="{Binding DeleteTickerCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                        <Button Content="↻" 
                                Command="{Binding ReloadTickersCommand}"
                                Padding="4,2"
                                Width="32"
                                Height="32"
                                Margin="0,0,10,0"
                                ToolTip="Reload Tickers"/>
                        <Button Content="CSV"
                                Command="{Binding ExportTickersAsCsvCommand}"
                                Padding="4,2"
                                Width="32"
                                Height="32"
                                Margin="0,0,10,0"
                                ToolTip="Export tickers as CSV"/>
                    </StackPanel>
                    <!--  Data grid -->
                    <Border Grid.Row="2" 
                            BorderBrush="{StaticResource Brush.Border}" 
                            Background="{StaticResource Brush.Surface}">
                        <DataGrid ItemsSource="{Binding Tickers}"
                                  SelectedItem="{Binding SelectedTicker}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">

                            <!-- Columns (excluding ExpectedPercent & Tier) -->
                            <DataGrid.Columns>

                                <!-- Name -->
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="Auto" />

                                <!-- Is Ignored -->
                                <DataGridCheckBoxColumn Header="Is Ignored"
                                                        Binding="{Binding IsIgnored}"
                                                        Width="Auto" />

                                <!-- Expected Percent -->
                                <DataGridTextColumn Header="Expected Percent"
                                                    Binding="{Binding ExpectedPercent,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    StringFormat={}{0:N2}}"
                                                    Width="Auto" />

                                <!-- Current Price -->
                                <DataGridTextColumn Header="Current Price"
                                                    IsReadOnly="True"
                                                    Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}"
                                                    Width="*" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Total Percent" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding TotalNotIgnoredPercent, StringFormat={}{0:N2}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Total Tickers" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     HorizontalContentAlignment="Right"
                                     Text="{Binding TotalNotIgnoredTickers}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Purchases">
                <Grid Margin="16" Background="{StaticResource Brush.Background}" DataContext="{Binding BuyViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="New Purchase Transaction" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Asset" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Qty" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Price" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Date" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding DataContext.TickersViewModel.ActiveTickers, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding BuyOrder.Asset, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,4,0"/>
                        <Button Grid.Column="1"
                                Content="↻" 
                                Command="{Binding DataContext.TickersViewModel.ReloadTickersCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                Padding="4,2" 
                                Width = "50"
                                ToolTip="Reload Tickers"/>
                    </Grid>

                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding BuyOrder.Qty, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8"/>

                    <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BuyOrder.Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 Margin="0,0,4,0"/>
                        <Button Grid.Column="1"
                                Content="Current"
                                Command="{Binding SetBuyOrderPriceAsCurrentCommand}"
                                Padding="8,2"
                                ToolTip="Set current market price"/>
                    </Grid>

                    <DatePicker Grid.Row="2" Grid.Column="3"
                                Text="{Binding BuyOrder.Date, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8"/>
                    <Button Grid.Row="3" Grid.Column="0"
                            Content="Buy"
                            Command="{Binding BuyAssetCommand}"
                            Margin="0,0,8,16"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding BuyOrder.Status}"
                               Foreground="{StaticResource Brush.Success}"
                               VerticalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="History Records" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    
                    <DataGrid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding BuyOrders}"
                              SelectedItem="{Binding SelectedHistoricalBuyOrder}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset"
                                                Binding="{Binding Asset, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="Delete">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <Button Content="Delete"
                                                Background="{StaticResource Brush.Error}"
                                                Command="{Binding DataContext.DeleteHistoricalBuyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Save">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveHistoricalBuyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Sales">
                <Grid Margin="16" Background="{StaticResource Brush.Background}" DataContext="{Binding SellViewModel}">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="New Sale Transaction" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Asset" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Qty" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Price" FontWeight="SemiBold" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Date" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding DataContext.TickersViewModel.ActiveTickers, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SellOrder.Asset, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,4,0"/>
                        <Button Grid.Column="1"
                                Content="↻" 
                                Command="{Binding DataContext.TickersViewModel.ReloadTickersCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                Padding="4,2" 
                                Width = "50"
                                ToolTip="Reload Tickers"/>
                    </Grid>

                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding SellOrder.Qty, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8"/>

                    <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SellOrder.Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 Margin="0,0,4,0"/>
                        <Button Grid.Column="1"
                                Content="Current"
                                Command="{Binding SetSellOrderPriceAsCurrentCommand}"
                                Padding="8,2"
                                ToolTip="Set current market price"/>
                    </Grid>

                    <DatePicker Grid.Row="2" Grid.Column="3"
                                Text="{Binding SellOrder.Date, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8"/>
                    <Button Grid.Row="3" Grid.Column="0"
                            Content="Sell"
                            Command="{Binding SellAssetCommand}"
                            Margin="0,0,8,16"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding SellOrder.Status}"
                               Foreground="{StaticResource Brush.Success}"
                               VerticalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="History Records" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    
                    <DataGrid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding SellOrders}"
                              SelectedItem="{Binding SelectedHistoricalSellOrder}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset"
                                                Binding="{Binding Asset, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="Delete">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <Button Content="Delete"
                                                Background="{StaticResource Brush.Error}"
                                                Command="{Binding DataContext.DeleteHistoricalSellOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Save">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveHistoricalSellOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Totals">
                <Grid Margin="16" DataContext="{Binding BoughtAssetsViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 🔹 Top bar -->
                    <Button Grid.Row="0"
                            Content="Load Assets"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10"
                            Command="{Binding SeeBoughtAssetsCommand}" />

                    <!-- 🔹 Data grid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AssetSummary.Assets}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <!-- Columns (excluding ExpectedPercent & Tier) -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" Width="Auto" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="Auto" />
                            <DataGridTextColumn Header="Avg Price" Binding="{Binding AvgPrice, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Purchase Total" Binding="{Binding PurchaseTotal, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Current Price" Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Percent" Binding="{Binding Percent, StringFormat={}{0:N2}}" Width="*" />
                            <DataGridTextColumn Header="Expected Percent" Binding="{Binding ExpectedPercent, StringFormat={}{0:N2}}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 🔹 Summary info -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Total Value" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.TotalValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Total PnL" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.TotalPnL, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Best Asset" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.BestAsset, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Worst Asset" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.WorstAsset, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>



            <TabItem Header="Recommendations">
                <Grid Margin="16" DataContext="{Binding RecommendationsViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="1"
                             Margin="0,0,8,0"
                             Text="{Binding AmountToInvest, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"/>
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="Recommend Assets"
                            Margin="0,0,0,0"
                            Command="{Binding RecommendAssetsCommand}" />

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                        <DataGrid ItemsSource="{Binding Recommendations}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="New" Binding="{Binding NewAsset, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
