<Window x:Class="FundMarket.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="FundMarket Dashboard"
        Height="600" Width="900"
        mc:Ignorable="d">
    <Grid Margin="12">
        <!-- 🔹 Resources -->
        <Grid.Resources>
        </Grid.Resources>
        <TabControl>
            <TabItem Header="Tickers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 🔹 Top bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <TextBox Width="200" 
                                 Margin="0,6,10,5"
                                 Padding="5,5,5,5"
                                 Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}"
                                 />
                        <Button Content="Add Ticker"
                                Command="{Binding AddTickerCommand}"/>
                        <Button Content="Save Selected"
                                Command="{Binding SaveTickerCommand}"/>
                        <Button Content="Save All"
                                Command="{Binding SaveAllTickersCommand}"/>
                        <Button Content="Delete Selected"
                                Command="{Binding DeleteTickerCommand}"/>
                    </StackPanel>
                    <!-- 🔹 Data grid -->
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="5">
                        <DataGrid ItemsSource="{Binding Tickers}"
                                  SelectedItem="{Binding SelectedTicker}"
                                  AutoGenerateColumns="False"
                                  AlternatingRowBackground="#F7F9FC"
                                  RowBackground="White"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">

                            <!-- Columns (excluding ExpectedPercent & Tier) -->
                            <DataGrid.Columns>

                                <!-- Name -->
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />

                                <!-- Is Ignored -->
                                <DataGridCheckBoxColumn Header="Is Ignored"
                                                        Binding="{Binding IsIgnored}"
                                                        Width="*" />

                                <!-- Expected Percent -->
                                <DataGridTextColumn Header="Expected Percent"
                                                    Binding="{Binding ExpectedPercent,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    StringFormat={}{0:N2}}"
                                                    Width="*" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Purchases">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Qty" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Price" />
                    
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Date"/>

                    <!-- Row 1 : Inputs -->
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding BuyOrder.Asset, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding BuyOrder.Qty, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding BuyOrder.Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />

                    <DatePicker Grid.Row="1" Grid.Column="3"
                                Text="{Binding BuyOrder.Date, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="2" Grid.Column="0"
                            Content="Buy"
                            Command="{Binding BuyAssetCommand}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding BuyOrder.Status}"
                               Foreground="Green"
                               VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="History Records" />
                    
                    <DataGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding BuyOrders}"
                              SelectedItem="{Binding SelectedHistoricalBuyOrder}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset"
                                                Binding="{Binding Asset, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="Delete">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteHistoricalBuyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Save">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveHistoricalBuyOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Sales">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Asset"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Qty" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Price" />
                    
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Date"/>

                    <!-- Row 1 : Inputs -->
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Text="{Binding SellOrder.Asset, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding SellOrder.Qty, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="1" Grid.Column="2"
                             Text="{Binding SellOrder.Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" />

                    <DatePicker Grid.Row="1" Grid.Column="3"
                                Text="{Binding SellOrder.Date, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="2" Grid.Column="0"
                            Content="Buy"
                            Command="{Binding SellAssetCommand}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding SellOrder.Status}"
                               Foreground="Green"
                               VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="History Records" />
                    
                    <DataGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding SellOrders}"
                              SelectedItem="{Binding SelectedHistoricalSellOrder}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset"
                                                Binding="{Binding Asset, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                Width="*" />
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" />
                            <DataGridTemplateColumn Header="Delete">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteHistoricalSellOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Save">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveHistoricalSellOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Totals">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 🔹 Top bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <TextBox Width="200" 
                                 IsReadOnly="True"
                                 Visibility="Hidden"
                                 Margin="0,6,10,5"
                                 Padding="5,5,5,5"/>
                        <Button Margin="0,6,10,5"
                                Padding="5,5,5,5"
                                Content="Load Assets"
                                Command="{Binding SeeBoughtAssetsCommand}" />
                    </StackPanel>

                    <!-- 🔹 Data grid -->
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="5">
                        <DataGrid ItemsSource="{Binding AssetSummary.Assets}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  AlternatingRowBackground="#F7F9FC"
                                  RowBackground="White"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">

                            <!-- Columns (excluding ExpectedPercent & Tier) -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" Width="Auto" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="Auto" />
                                <DataGridTextColumn Header="Avg Price" Binding="{Binding AvgPrice, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Purchase Total" Binding="{Binding PurchaseTotal, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Current Price" Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Percent" Binding="{Binding Percent, StringFormat={}{0:N2}}" Width="*" />
                                <DataGridTextColumn Header="Expected Percent" Binding="{Binding ExpectedPercent, StringFormat={}{0:N2}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 🔹 Summary info -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Total Value" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.TotalValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Total PnL" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.TotalPnL, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Best Asset" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.BestAsset, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Worst Asset" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Width="150" IsReadOnly="True"
                                     Text="{Binding AssetSummary.WorstAsset, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>



            <TabItem Header="Recommendations">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <TextBox Width="200" 
                                 Margin="0,6,10,5"
                                 Padding="5,5,5,5"
                                 Text="{Binding AmountToInvest, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"/>
                        <Button Content="Recommend Assets"
                                Command="{Binding RecommendAssetsCommand}" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="5">
                        <DataGrid ItemsSource="{Binding Recommendations}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  AlternatingRowBackground="#F7F9FC"
                                  RowBackground="White"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="New" Binding="{Binding NewAsset, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
